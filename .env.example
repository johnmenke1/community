# =============================================================================
# Community Platform — environment variables
# Copy this file to .env.local in apps/api/ (and apps/web/ if needed) and fill
# in real values. NEVER commit a real .env* file.
# =============================================================================

# Postgres connection string used by the API and the @community/db package.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://community:community@localhost:5432/community

# Cloudflare account id (RealtimeKit + Workers). Used in apps/api realtime stub.
CF_ACCOUNT_ID=replace-me

# Cloudflare RealtimeKit user-scoped API token (cfut_*). Keep secret. Used in
# apps/api RealtimeService to issue meeting tokens (commit 2).
CF_REALTIMEKIT_TOKEN=replace-me

# better-auth signing secret. Generate with: openssl rand -hex 32
# Used by apps/api auth module and apps/web to validate sessions.
BETTER_AUTH_SECRET=dev-secret-change-me-in-prod-1234567890

# Base URL of the web app. better-auth uses this to construct callback URLs.
BETTER_AUTH_URL=http://localhost:3000

# API and web ports (read in apps/api/src/main.ts and apps/web scripts).
API_PORT=3001
WEB_PORT=3000

# Node environment.
NODE_ENV=development
